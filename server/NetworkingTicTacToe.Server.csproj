<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="CopyClientDistToPublishWwwroot" AfterTargets="Publish" Condition="Exists('..\client\dist')">
    <ItemGroup>
      <ClientDistAssets Include="..\client\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientDistAssets)"
          DestinationFiles="@(ClientDistAssets->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
